# Cadena de conexión de tu base de datos Postgres (Neon, Supabase, etc.)
# En Neon: crea un proyecto en https://neon.tech y copia el "Connection string".
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Cualquier texto largo y aleatorio, usado para firmar las cookies de sesión.
SESSION_SECRET=cambia-esto-por-un-texto-aleatorio-largo

# La contraseña para entrar a /admin (elige la que quieras).
ADMIN_PASSWORD=cambia-esto

# Render la pone sola en producción; en local puedes dejarla o cambiarla.
PORT=3000

# --- Fase 2 (opcional): si no las pones, el envío de correo queda en modo
# prueba (se escribe en la consola en vez de mandarse de verdad).

# API key de Resend (https://resend.com → API Keys). Empieza con "re_".
RESEND_API_KEY=

# Remitente de los correos. El de prueba de Resend funciona sin verificar
# un dominio propio.
RESEND_FROM=Aleteo <onboarding@resend.dev>

# URL pública del sitio, para que los correos programados armen el link
# correcto aunque no haya nadie navegando en ese momento.
SITE_URL=http://localhost:3000

# --- Fase 3 (opcional): sin esta llave, el carrito vuelve al checkout sin
# cobro de la Fase 2 ("Finalizar pedido, sin cobro").

# Secret key de modo prueba de Stripe (https://dashboard.stripe.com →
# Developers → API keys, con "Test mode" activado). Empieza con "sk_test_".
# Con tarjeta de prueba 4242 4242 4242 4242 (cualquier fecha futura y CVC)
# se puede probar un pago completo sin cobrar nada real.
STRIPE_SECRET_KEY=
