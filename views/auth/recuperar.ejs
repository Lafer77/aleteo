<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recuperar contraseña — Aleteo</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<header>
  <nav class="nav">
    <a href="/" class="logo"><span class="dot"></span>Aleteo</a>
  </nav>
</header>

<section class="page">
  <div class="wrap page-narrow">
    <h1>Recupera tu contraseña</h1>
    <p class="lede">Te mandamos un link para elegir una contraseña nueva.</p>

    <% if (enviado) { %>
      <div class="form-note">Si el correo existe en Aleteo, se envió un link de recuperación.</div>
    <% } else { %>
      <form method="POST" action="/auth/recuperar">
        <div class="field">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" required>
        </div>
        <button type="submit" class="btn-primary">Enviar link</button>
      </form>
    <% } %>

    <div class="form-foot"><a href="/auth/login">Volver a iniciar sesión</a></div>
  </div>
</section>
</body>
</html>
